---
import { Image } from "astro:assets";
import { siteConfig } from "@/config";

const { image, title, subtitle } = siteConfig.hero;
---

<section class="relative h-[26rem] w-full overflow-hidden md:h-[30rem]">
  <Image
    src={image}
    alt=""
    widths={[640, 960, 1280, 1920, 2560]}
    sizes="100vw"
    format="webp"
    loading="eager"
    fetchpriority="high"
    class="hero-img absolute inset-0 size-full object-cover"
  />
  <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/10 to-black/25"></div>

  <div class="relative z-10 flex h-full flex-col items-center justify-center gap-3 px-4 pt-24 pb-16 text-center text-white">
    <h1 class="hero-title text-4xl font-bold tracking-tight drop-shadow-lg md:text-6xl">{title}</h1>
    <p class="hero-sub text-base drop-shadow md:text-xl">{subtitle}</p>
  </div>

  <!-- 下端の波。ページ背景色で塗って画像との境界を波立たせる -->
  <svg
    class="hero-wave absolute inset-x-0 bottom-0 h-16 w-full md:h-24"
    viewBox="0 24 150 28"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <defs>
      <path id="wave" d="M-160 44c30 0 58-18 88-18s58 18 88 18 58-18 88-18 58 18 88 18v44h-352z"></path>
    </defs>
    <g class="wave-group">
      <use href="#wave" x="48" y="0" style="fill: var(--page-bg); opacity: 0.35"></use>
      <use href="#wave" x="48" y="3" style="fill: var(--page-bg); opacity: 0.55"></use>
      <use href="#wave" x="48" y="5" style="fill: var(--page-bg); opacity: 0.8"></use>
      <use href="#wave" x="48" y="7" style="fill: var(--page-bg)"></use>
    </g>
  </svg>
</section>

<style>
  /* 初回読み込み時のみ: 背景がゆっくりズームアウト → タイトル → サブタイトル → 波がせり上がる */
  :global(html.intro) .hero-img {
    animation: hero-zoom 1.8s cubic-bezier(0.22, 1, 0.36, 1) var(--intro-delay) both;
  }
  :global(html.intro) .hero-title {
    animation: hero-rise 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) calc(var(--intro-delay) + 0.2s) both;
  }
  :global(html.intro) .hero-sub {
    animation: hero-rise 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) calc(var(--intro-delay) + 0.4s) both;
  }
  :global(html.intro) .hero-wave {
    animation: wave-rise 1s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--intro-delay) + 0.3s) both;
  }
  @keyframes hero-zoom {
    from {
      transform: scale(1.12);
    }
    to {
      transform: scale(1);
    }
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes wave-rise {
    from {
      transform: translateY(100%);
    }
    to {
      transform: none;
    }
  }
  .wave-group use {
    animation: wave-move 20s cubic-bezier(0.55, 0.5, 0.45, 0.5) infinite;
  }
  .wave-group use:nth-child(1) {
    animation-delay: -2s;
    animation-duration: 7s;
  }
  .wave-group use:nth-child(2) {
    animation-delay: -3s;
    animation-duration: 10s;
  }
  .wave-group use:nth-child(3) {
    animation-delay: -4s;
    animation-duration: 13s;
  }
  .wave-group use:nth-child(4) {
    animation-delay: -5s;
    animation-duration: 20s;
  }
  @keyframes wave-move {
    0% {
      transform: translateX(-90px);
    }
    100% {
      transform: translateX(85px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-img,
    .hero-title,
    .hero-sub,
    .hero-wave,
    .wave-group use {
      animation: none;
    }
  }
</style>
