---
import { tablerSvgs } from "@/utils/icons";

const icons = tablerSvgs(["copy", "check"]);
---

<script type="application/json" id="copy-icons" set:html={JSON.stringify(icons)} />
<script>
  document.addEventListener("astro:page-load", () => {
    const icons: Record<string, string> = JSON.parse(document.getElementById("copy-icons")?.textContent ?? "{}");

    for (const pre of document.querySelectorAll<HTMLPreElement>(".prose pre")) {
      // pre 自体は横スクロールするので、ボタンは外側のラッパーに置いて流れないようにする
      const wrap = document.createElement("div");
      wrap.className = "group relative";
      pre.replaceWith(wrap);
      wrap.append(pre);
      const btn = document.createElement("button");
      btn.type = "button";
      btn.title = btn.ariaLabel = "Copy code";
      btn.innerHTML = icons.copy;
      btn.className =
        "absolute top-2 right-2 flex size-8 items-center justify-center rounded-md bg-white/15 text-white backdrop-blur-sm opacity-0 transition group-hover:opacity-100 hover:bg-white/25 focus:opacity-100";
      btn.addEventListener("click", async () => {
        await navigator.clipboard.writeText(pre.querySelector("code")?.innerText ?? pre.innerText);
        btn.innerHTML = icons.check;
        setTimeout(() => (btn.innerHTML = icons.copy), 1500);
      });
      wrap.append(btn);
    }
  });
</script>
