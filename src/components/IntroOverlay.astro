---
import { siteConfig } from "@/config";
---

<!-- 初回読み込み時だけ表示される全画面カーテン。html.intro が付いている間のみ有効 -->
<div id="intro-overlay" aria-hidden="true" class="bg-primary fixed inset-0 z-[100] hidden items-center justify-center text-white">
  <div class="intro-title text-center">
    <div class="text-5xl font-bold tracking-tight md:text-7xl">{siteConfig.title}</div>
    <div class="mt-2 text-sm opacity-80 md:text-base">{siteConfig.subtitle}</div>
  </div>
  <!-- カーテンの下端。一緒に持ち上がって境界を波立たせる -->
  <svg class="absolute top-full left-0 h-12 w-full md:h-20" viewBox="0 0 1200 100" preserveAspectRatio="none" fill="currentColor">
    <path class="text-primary" d="M0 0h1200v40c-100 40-200 40-300 0s-200-40-300 0-200 40-300 0-200-40-300 0z"></path>
  </svg>
</div>

<style is:global>
  html.intro #intro-overlay {
    display: flex;
    animation: intro-cover 0.9s cubic-bezier(0.76, 0, 0.24, 1) 0.9s both;
  }
  html.intro .intro-title {
    animation: intro-title 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s both;
  }
  @keyframes intro-cover {
    to {
      transform: translateY(calc(-100% - 6rem));
      visibility: hidden;
    }
  }
  @keyframes intro-title {
    from {
      opacity: 0;
      transform: scale(0.8) translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    html.intro #intro-overlay {
      display: none;
    }
  }
</style>
