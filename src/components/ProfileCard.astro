---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { profileConfig } from "@/config";

const { avatar } = profileConfig;
---

<div class="card p-4 text-center">
  <div class="bg-btn text-primary mx-auto mb-4 flex size-32 items-center justify-center overflow-hidden rounded-2xl text-5xl font-bold">
    {typeof avatar === "string" && avatar ? (
      <img src={avatar} alt={profileConfig.name} width="128" height="128" decoding="async" class="size-full object-cover" />
    ) : typeof avatar === "object" ? (
      <Image
        src={avatar}
        alt={profileConfig.name}
        width={128}
        height={128}
        densities={[1, 2]}
        format="webp"
        class="size-full object-cover"
      />
    ) : (
      profileConfig.name[0]
    )}
  </div>
  <div class="text-xl font-bold">{profileConfig.name}</div>
  <div class="bg-primary mx-auto my-2 h-1 w-5 rounded-full"></div>
  <p class="text-ink-sub mb-3 text-sm">{profileConfig.bio}</p>
  <div class="flex flex-wrap justify-center gap-2">
    {profileConfig.links.map((l) => (
      <a href={l.url} aria-label={l.name} class="btn size-10 text-xl" target="_blank" rel="noopener noreferrer">
        <Icon name={l.icon} />
      </a>
    ))}
  </div>
</div>
