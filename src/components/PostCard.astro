---
import { withBase } from "@/utils/url";
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";
import { formatDate } from "@/utils/posts";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { title, published, description, tags, category } = post.data;
---

<article class="card relative p-6 transition hover:shadow-md">
  <a href={withBase(`/posts/${post.id}`)} class="group block">
    <h2 class="before:bg-primary relative mb-3 pl-4 text-2xl font-bold transition group-hover:text-primary before:absolute before:top-2 before:bottom-2 before:left-0 before:w-1 before:rounded-full">
      {title}
    </h2>
  </a>
  <div class="text-ink-sub mb-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm">
    <span class="flex items-center gap-1">
      <Icon name="tabler:calendar" />
      {formatDate(published)}
    </span>
    <a href={withBase(`/categories/${encodeURIComponent(category)}`)} class="hover:text-primary flex items-center gap-1">
      <Icon name="tabler:folder" />
      {category}
    </a>
    {tags.length > 0 && (
      <span class="flex items-center gap-1">
        <Icon name="tabler:hash" />
        {tags.map((t, i) => (
          <>
            {i > 0 && " / "}
            <a href={withBase(`/tags/${encodeURIComponent(t)}`)} class="hover:text-primary">
              {t}
            </a>
          </>
        ))}
      </span>
    )}
  </div>
  <p class="text-ink-sub">{description}</p>
</article>
