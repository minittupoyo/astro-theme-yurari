---
import { withBase } from "@/utils/url";
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";

interface Props {
  prev?: CollectionEntry<"posts">;
  next?: CollectionEntry<"posts">;
}

const { prev, next } = Astro.props;
---

{(prev || next) && (
  <nav class="mt-4 grid gap-4 sm:grid-cols-2" aria-label="Previous and next posts">
    {prev ? (
      <a href={withBase(`/posts/${prev.id}`)} rel="prev" class="btn card group h-auto min-h-16 justify-start gap-3 px-4 py-3 text-left">
        <Icon name="tabler:chevron-left" class="text-primary shrink-0 text-2xl" />
        <span class="min-w-0">
          <span class="text-ink-sub block text-xs">Previous post</span>
          <span class="group-hover:text-primary block font-semibold">{prev.data.title}</span>
        </span>
      </a>
    ) : (
      <span class="hidden sm:block" />
    )}
    {next && (
      <a href={withBase(`/posts/${next.id}`)} rel="next" class="btn card group h-auto min-h-16 justify-end gap-3 px-4 py-3 text-right">
        <span class="min-w-0">
          <span class="text-ink-sub block text-xs">Next post</span>
          <span class="group-hover:text-primary block font-semibold">{next.data.title}</span>
        </span>
        <Icon name="tabler:chevron-right" class="text-primary shrink-0 text-2xl" />
      </a>
    )}
  </nav>
)}
