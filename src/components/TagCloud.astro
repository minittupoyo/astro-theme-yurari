---
import { countBy, getSortedPosts } from "@/utils/posts";

interface Props {
  // 表示するタグの最大数 (記事数の多い順)
  limit?: number;
}

const { limit = 30 } = Astro.props;
const tags = countBy((await getSortedPosts()).flatMap((p) => p.data.tags)).slice(0, limit);

// 記事数に応じて 0.8rem 〜 1.2rem で文字の大きさを変える
const counts = tags.map(([, n]) => n);
const min = Math.min(...counts);
const max = Math.max(...counts);
const size = (n: number) => (0.8 + (max === min ? 0.2 : ((n - min) / (max - min)) * 0.4)).toFixed(2);

const current = Astro.params.tag;
---

{tags.length > 0 && (
  <section class="card p-4" aria-label="Tag cloud">
    <div class="mb-3 flex items-center justify-between">
      <h2 class="font-bold">Tags</h2>
      <a href="/tags" class="text-primary text-xs underline">
        View all
      </a>
    </div>
    <div class="flex flex-wrap items-center gap-1.5">
      {tags.map(([tag, n]) => (
        <a
          href={`/tags/${encodeURIComponent(tag)}`}
          style={`font-size: ${size(n)}rem`}
          title={`${n} ${n === 1 ? "post" : "posts"}`}
          class:list={["btn h-auto px-2.5 py-1 leading-tight", tag === current && "!bg-primary text-white"]}
        >
          #{tag}
        </a>
      ))}
    </div>
  </section>
)}
