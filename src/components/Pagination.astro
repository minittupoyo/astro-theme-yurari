---
import { Icon } from "astro-icon/components";
import type { Page } from "astro";
import { withBase } from "@/utils/url";

interface Props {
  page: Page;
  // 1ページ目のURL (例: "/", "/tags/foo")
  base: string;
}

const { page, base } = Astro.props;
const root = withBase(base).replace(/\/$/, "");
const href = (n: number) => (n === 1 ? root || "/" : `${root}/${n}`);

// 現在ページの前後2ページ + 先頭・末尾。間は省略(…)
const nums: (number | null)[] = [];
for (let i = 1; i <= page.lastPage; i++) {
  if (i === 1 || i === page.lastPage || Math.abs(i - page.currentPage) <= 1) nums.push(i);
  else if (nums.at(-1) !== null) nums.push(null);
}
---

{page.lastPage > 1 && (
  <nav class="mt-4 flex items-center justify-center gap-2" aria-label="Pagination">
    {page.url.prev ? (
      <a href={href(page.currentPage - 1)} class="btn card size-11 text-xl" aria-label="Previous page" rel="prev">
        <Icon name="tabler:chevron-left" />
      </a>
    ) : (
      <span class="card flex size-11 items-center justify-center text-xl opacity-40">
        <Icon name="tabler:chevron-left" />
      </span>
    )}

    {nums.map((n) =>
      n === null ? (
        <span class="text-ink-sub px-1">…</span>
      ) : n === page.currentPage ? (
        <span class="bg-primary flex size-11 items-center justify-center rounded-lg font-bold text-white" aria-current="page">
          {n}
        </span>
      ) : (
        <a href={href(n)} class="btn card size-11 font-semibold">
          {n}
        </a>
      ),
    )}

    {page.url.next ? (
      <a href={href(page.currentPage + 1)} class="btn card size-11 text-xl" aria-label="Next page" rel="next">
        <Icon name="tabler:chevron-right" />
      </a>
    ) : (
      <span class="card flex size-11 items-center justify-center text-xl opacity-40">
        <Icon name="tabler:chevron-right" />
      </span>
    )}
  </nav>
)}
