---
import { siteConfig } from "@/config";
---

<!-- 項目の間隔は gap で取る (Prettier が空白を詰めても崩れないように) -->
<footer class="text-ink-sub mx-auto w-full max-w-5xl px-4 pb-8">
  <div class="card flex flex-wrap items-center justify-center gap-x-2 px-4 py-6 text-sm">
    <span>{`© ${new Date().getFullYear()} ${siteConfig.title}`}</span>
    <span aria-hidden="true">·</span>
    <a href="/rss.xml" class="text-primary underline">
      RSS
    </a>
    <span aria-hidden="true">·</span>
    <span>
      Powered by{" "}
      <a href="https://astro.build" class="text-primary underline">
        Astro
      </a>
    </span>
  </div>
</footer>
