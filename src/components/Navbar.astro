---
import { Icon } from "astro-icon/components";
import { navLinks, siteConfig } from "@/config";
import { isCurrent, withBase } from "@/utils/url";

const path = Astro.url.pathname;
const searchIndexUrl = withBase("/search.json");
---

<header transition:name="navbar" transition:animate="none" class="fixed inset-x-0 top-0 z-50 px-4 pt-3">
  <nav class="card relative mx-auto flex h-16 max-w-5xl items-center justify-between gap-2 px-4 shadow-sm">
    <a href={withBase("/")} class="btn h-11 min-w-0 justify-start bg-transparent px-3 text-lg font-bold">
      <span class="truncate">{siteConfig.title}</span>
    </a>

    <div class="flex shrink-0 items-center gap-1">
      {navLinks.map((l) => (
        <a
          href={withBase(l.url)}
          class:list={["btn hidden h-11 px-4 font-semibold sm:inline-flex", "bg-transparent", isCurrent(path, l.url) && "text-primary"]}
        >
          {l.name}
        </a>
      ))}

      <button id="search-btn" class="btn size-11 bg-transparent text-xl" aria-label="Search">
        <Icon name="tabler:search" />
      </button>

      <div class="relative">
        <button id="hue-btn" class="btn size-11 bg-transparent text-xl" aria-label="Theme color">
          <Icon name="tabler:palette" />
        </button>
        <div id="hue-panel" class="card absolute top-14 right-0 hidden w-64 p-4 shadow-lg">
          <div class="mb-3 flex items-center justify-between font-bold">
            Theme color
            <span id="hue-value" class="bg-btn text-primary rounded-md px-2 py-0.5 text-sm"></span>
          </div>
          <input id="hue-range" type="range" min="0" max="360" class="hue-range h-3 w-full appearance-none rounded-full" />
        </div>
      </div>

      <button id="theme-btn" class="btn size-11 bg-transparent text-xl" aria-label="Toggle dark mode">
        <Icon name="tabler:sun" class="dark:hidden" />
        <Icon name="tabler:moon" class="hidden dark:block" />
      </button>

      <button
        id="menu-btn"
        class="btn size-11 bg-transparent text-xl sm:hidden"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="tabler:menu-2" class="menu-open" />
        <Icon name="tabler:x" class="menu-close" />
      </button>
    </div>

    <!-- モバイル用メニュー (sm 未満のみ) -->
    <ul id="mobile-menu" class="card absolute inset-x-0 top-[4.5rem] hidden p-2 shadow-lg sm:hidden">
      {navLinks.map((l) => (
        <li>
          <a
            href={withBase(l.url)}
            class:list={["btn flex h-12 w-full justify-start bg-transparent px-4 font-semibold", isCurrent(path, l.url) && "text-primary"]}
          >
            {l.name}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<div id="search-modal" data-index={searchIndexUrl} class="fixed inset-0 z-[60] hidden items-start justify-center bg-black/40 px-4 pt-24">
  <div class="card w-full max-w-lg p-4 shadow-xl">
    <input
      id="search-input"
      type="search"
      placeholder="Search posts..."
      class="bg-btn w-full rounded-lg px-4 py-3 outline-none focus:ring-2 focus:ring-[var(--primary)]"
    />
    <ul id="search-results" class="mt-3 max-h-80 overflow-y-auto"></ul>
  </div>
</div>

<style is:global>
  #menu-btn .menu-close,
  #menu-btn[aria-expanded="true"] .menu-open {
    display: none;
  }
  #menu-btn[aria-expanded="true"] .menu-close {
    display: block;
  }
  #mobile-menu:not(.hidden) {
    transform-origin: top right;
    animation: panel-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  /* 登場アニメーション (hidden が外れて表示されるたびに再生) */
  #hue-panel:not(.hidden) {
    transform-origin: top right;
    animation: panel-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  #search-modal.flex {
    animation: backdrop-in 0.2s ease-out both;
  }
  #search-modal.flex > .card {
    animation: modal-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  @keyframes panel-pop {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.9);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes backdrop-in {
    from {
      opacity: 0;
    }
  }
  @keyframes modal-pop {
    from {
      opacity: 0;
      transform: translateY(-16px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #mobile-menu,
    #hue-panel,
    #search-modal,
    #search-modal > .card {
      animation: none !important;
    }
  }
  .hue-range {
    background-image: linear-gradient(
      to right,
      oklch(0.7 0.14 0),
      oklch(0.7 0.14 60),
      oklch(0.7 0.14 120),
      oklch(0.7 0.14 180),
      oklch(0.7 0.14 240),
      oklch(0.7 0.14 300),
      oklch(0.7 0.14 360)
    );
  }
  .hue-range::-webkit-slider-thumb {
    appearance: none;
    width: 6px;
    height: 20px;
    border-radius: 3px;
    background: white;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.3);
  }
  .hue-range::-moz-range-thumb {
    width: 6px;
    height: 20px;
    border: 0;
    border-radius: 3px;
    background: white;
  }
</style>

<script>
  // ClientRouter でページ遷移しても動くよう、要素への登録は astro:page-load ごとに行う。
  // document への登録は1回だけ(モジュールは再実行されない)。
  const root = document.documentElement;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  type Item = { id: string; url: string; title: string; description: string; tags: string[]; category: string; body: string };
  let index: Item[] | null = null;

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

  const toggleSearch = async (open: boolean) => {
    const modal = $("search-modal");
    modal.classList.toggle("hidden", !open);
    modal.classList.toggle("flex", open);
    if (!open) return;
    $<HTMLInputElement>("search-input").focus();
    index ??= await (await fetch(modal.dataset.index!)).json();
  };

  const renderResults = () => {
    const results = $("search-results");
    const words = $<HTMLInputElement>("search-input").value.toLowerCase().split(/\s+/).filter(Boolean);
    if (!words.length || !index) {
      results.innerHTML = "";
      return;
    }
    const hits = index.filter((p) => {
      const text = `${p.title} ${p.description} ${p.tags.join(" ")} ${p.category} ${p.body}`.toLowerCase();
      return words.every((w) => text.includes(w));
    });
    results.innerHTML = hits.length
      ? hits
          .map(
            (p) => `<li><a href="${p.url}" class="btn block h-auto w-full bg-transparent px-3 py-2 text-left">
              <div class="font-semibold">${esc(p.title)}</div>
              <div class="text-ink-sub text-sm">${esc(p.description)}</div></a></li>`,
          )
          .join("")
      : '<li class="text-ink-sub px-3 py-2 text-sm">No results found</li>';
  };

  const setMenu = (open: boolean) => {
    document.getElementById("mobile-menu")?.classList.toggle("hidden", !open);
    document.getElementById("menu-btn")?.setAttribute("aria-expanded", String(open));
  };

  document.addEventListener("click", (e) => {
    const panel = document.getElementById("hue-panel");
    if (panel && !panel.contains(e.target as Node)) panel.classList.add("hidden");
    // メニュー外のクリック、またはメニュー内のリンクで閉じる
    const target = e.target as Element;
    if (!target.closest("#menu-btn") && (!target.closest("#mobile-menu") || target.closest("#mobile-menu a"))) setMenu(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      toggleSearch(false);
      setMenu(false);
    }
    if ((e.ctrlKey || e.metaKey) && e.key === "k") {
      e.preventDefault();
      toggleSearch(true);
    }
  });

  document.addEventListener("astro:page-load", () => {
    const panel = $("hue-panel");
    const range = $<HTMLInputElement>("hue-range");
    const value = $("hue-value");

    const hue = getComputedStyle(root).getPropertyValue("--hue").trim();
    range.value = hue;
    value.textContent = hue;

    $("theme-btn").addEventListener("click", () => {
      const dark = root.classList.toggle("dark");
      localStorage.setItem("theme", dark ? "dark" : "light");
    });

    $("hue-btn").addEventListener("click", (e) => {
      e.stopPropagation();
      panel.classList.toggle("hidden");
    });

    range.addEventListener("input", () => {
      root.style.setProperty("--hue", range.value);
      localStorage.setItem("hue", range.value);
      value.textContent = range.value;
    });

    $("menu-btn").addEventListener("click", () => {
      $("hue-panel").classList.add("hidden");
      setMenu($("mobile-menu").classList.contains("hidden"));
    });

    $("search-btn").addEventListener("click", () => {
      setMenu(false);
      toggleSearch(true);
    });
    $("search-input").addEventListener("input", renderResults);
    $("search-modal").addEventListener("click", (e) => {
      if (e.target === e.currentTarget) toggleSearch(false);
    });
  });
</script>
