---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import { siteConfig } from "@/config";
import { formatDate } from "@/utils/posts";

const posts = (await getCollection("posts", (p) => !p.data.draft)).sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
const byYear = Map.groupBy(posts, (p) => p.data.published.getFullYear());
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<Layout title="Archive">
  <div class="card p-6">
    {years.map((year) => (
      <section class="mb-6 last:mb-0">
        <h2 class="mb-2 text-2xl font-bold">{year}</h2>
        <ul>
          {byYear.get(year)!.map((p) => (
            <li>
              <a href={`/posts/${p.id}`} class="btn flex h-11 w-full justify-start gap-4 bg-transparent px-3">
                <span class="text-ink-sub min-w-16 text-sm">{formatDate(p.data.published, siteConfig.archiveDateFormat)}</span>
                <span class="font-semibold">{p.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Layout>
