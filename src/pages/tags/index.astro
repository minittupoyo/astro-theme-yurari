---
import { withBase } from "@/utils/url";
import Layout from "@/layouts/Layout.astro";
import { countBy, getSortedPosts } from "@/utils/posts";

const tags = countBy((await getSortedPosts()).flatMap((p) => p.data.tags));
---

<Layout title="Tags">
  <div class="card p-6">
    <h1 class="mb-4 text-2xl font-bold">Tags</h1>
    <div class="flex flex-wrap gap-2">
      {tags.map(([tag, n]) => (
        <a href={withBase(`/tags/${encodeURIComponent(tag)}`)} class="btn h-9 gap-2 px-3 text-sm">
          #{tag}
          <span class="text-primary">{n}</span>
        </a>
      ))}
    </div>
  </div>
</Layout>
