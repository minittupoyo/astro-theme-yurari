---
import { withBase } from "@/utils/url";
import Layout from "@/layouts/Layout.astro";
import { countBy, getSortedPosts } from "@/utils/posts";

const categories = countBy((await getSortedPosts()).map((p) => p.data.category));
---

<Layout title="Categories">
  <div class="card p-6">
    <h1 class="mb-4 text-2xl font-bold">Categories</h1>
    <ul>
      {categories.map(([c, n]) => (
        <li>
          <a href={withBase(`/categories/${encodeURIComponent(c)}`)} class="btn flex h-11 w-full justify-between bg-transparent px-3">
            <span class="font-semibold">{c}</span>
            <span class="text-primary">{n}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Layout>
