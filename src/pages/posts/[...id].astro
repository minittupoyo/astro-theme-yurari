---
import { render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import PostNav from "@/components/PostNav.astro";
import { formatDate, getSortedPosts } from "@/utils/posts";
import CopyCodeButton from "@/components/CopyCodeButton.astro";
import HoverCard from "@/components/HoverCard.astro";
import ImageZoom from "@/components/ImageZoom.astro";

export async function getStaticPaths() {
  // 新しい順。前の記事 = 1つ古い記事、次の記事 = 1つ新しい記事
  const posts = await getSortedPosts();
  return posts.map((post, i) => ({ params: { id: post.id }, props: { post, prev: posts[i + 1], next: posts[i - 1] } }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const { title, published, description, category, tags } = post.data;
---

<Layout title={title} description={description}>
  <TableOfContents slot="sidebar" headings={headings} />
  <article class="card p-6 md:p-8">
    <h1 class="mb-3 text-3xl font-bold">{title}</h1>
    <div class="text-ink-sub mb-6 flex flex-wrap gap-x-4 text-sm">
      <span>{formatDate(published)}</span>
      <a href={`/categories/${encodeURIComponent(category)}`} class="hover:text-primary">
        {category}
      </a>
      {tags.map((t) => (
        <a href={`/tags/${encodeURIComponent(t)}`} class="text-primary">
          #{t}
        </a>
      ))}
    </div>
    <div class="prose">
      <Content />
    </div>
  </article>
  <PostNav prev={prev} next={next} />
  <CopyCodeButton />
  <HoverCard />
  <ImageZoom />
</Layout>
