---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import CopyCodeButton from "@/components/CopyCodeButton.astro";
import HoverCard from "@/components/HoverCard.astro";
import ImageZoom from "@/components/ImageZoom.astro";

const about = await getEntry("spec", "about");
if (!about) throw new Error("src/content/spec/about.md not found");
const { Content } = await render(about);
const { title, description } = about.data;
---

<Layout title={title} description={description}>
  <article class="card p-6 md:p-8">
    <h1 class="mb-6 text-3xl font-bold">{title}</h1>
    <div class="prose">
      <Content />
    </div>
  </article>
  <CopyCodeButton />
  <HoverCard />
  <ImageZoom />
</Layout>
